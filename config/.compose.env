RESTART_POLICY=unless-stopped
# where /movies, /tv, /torrents, and /music will be stored
DOWNLOADS_PATH=/mnt/hdd/downloads

# VPN
VPN_SERVICE_PROVIDER=nordvpn
VPN_TYPE=wireguard
SERVER_COUNTRIES=Australia
SERVER_CATEGORIES=P2P
VPN_IPV6=off
UPDATER_PERIOD=0

# subnets allowed to bypass the VPN 
FIREWALL_OUTBOUND_SUBNETS=172.24.0.0/16,192.168.1.0/24
